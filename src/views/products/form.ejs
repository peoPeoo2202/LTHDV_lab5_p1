<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>
        <i class="fas fa-box me-2"></i>
        <%= title %>
    </h2>
    <a href="/products" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-edit me-2"></i>
                    Product Information
                </h5>
            </div>
            <div class="card-body">
                <form method="POST" action="<%= action %>">
                    <input type="hidden" name="_method" value="<%= method === 'POST' && product._id ? 'PUT' : 'POST' %>">
                    
                    <div class="mb-3">
                        <label for="name" class="form-label">
                            Product Name <span class="required">*</span>
                        </label>
                        <input 
                            type="text" 
                            class="form-control <%= errors.find(e => e.path === 'name') ? 'is-invalid' : '' %>" 
                            id="name" 
                            name="name" 
                            value="<%= product.name || '' %>"
                            required
                        >
                        <% if (errors.find(e => e.path === 'name')) { %>
                            <div class="error-message">
                                <%= errors.find(e => e.path === 'name').msg %>
                            </div>
                        <% } %>
                    </div>
                    
                    <div class="mb-3">
                        <label for="supplierId" class="form-label">
                            Supplier <span class="required">*</span>
                        </label>
                        <select 
                            class="form-select <%= errors.find(e => e.path === 'supplierId') ? 'is-invalid' : '' %>" 
                            id="supplierId" 
                            name="supplierId" 
                            required
                        >
                            <option value="">Select a supplier...</option>
                            <% suppliers.forEach(supplier => { %>
                                <option 
                                    value="<%= supplier._id %>" 
                                    <%= (product.supplierId && product.supplierId.toString() === supplier._id.toString()) ? 'selected' : '' %>
                                >
                                    <%= supplier.name %>
                                    <% if (supplier.address) { %>
                                        - <%= supplier.address %>
                                    <% } %>
                                </option>
                            <% }) %>
                        </select>
                        <% if (errors.find(e => e.path === 'supplierId')) { %>
                            <div class="error-message">
                                <%= errors.find(e => e.path === 'supplierId').msg %>
                            </div>
                        <% } %>
                        <div class="form-text">
                            <a href="/suppliers/new" target="_blank" class="text-decoration-none">
                                <i class="fas fa-plus me-1"></i>Add new supplier
                            </a>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="address" class="form-label">Address</label>
                        <textarea 
                            class="form-control <%= errors.find(e => e.path === 'address') ? 'is-invalid' : '' %>" 
                            id="address" 
                            name="address" 
                            rows="3"
                        ><%= product.address || '' %></textarea>
                        <% if (errors.find(e => e.path === 'address')) { %>
                            <div class="error-message">
                                <%= errors.find(e => e.path === 'address').msg %>
                            </div>
                        <% } %>
                    </div>
                    
                    <div class="mb-3">
                        <label for="phone" class="form-label">Phone</label>
                        <input 
                            type="tel" 
                            class="form-control <%= errors.find(e => e.path === 'phone') ? 'is-invalid' : '' %>" 
                            id="phone" 
                            name="phone" 
                            value="<%= product.phone || '' %>"
                            placeholder="e.g., +1 (555) 123-4567"
                        >
                        <% if (errors.find(e => e.path === 'phone')) { %>
                            <div class="error-message">
                                <%= errors.find(e => e.path === 'phone').msg %>
                            </div>
                        <% } %>
                        <div class="form-text">
                            Enter a valid phone number (at least 10 characters)
                        </div>
                    </div>
                    
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="/products" class="btn btn-secondary me-md-2">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save me-2"></i>
                            <%= product._id ? 'Update Product' : 'Create Product' %>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>
        <i class="fas fa-box me-2"></i>
        Product Details
    </h2>
    <div>
        <a href="/products" class="btn btn-outline-secondary me-2">
            <i class="fas fa-arrow-left me-2"></i>Back to List
        </a>
        <a href="/products/<%= product._id %>/edit" class="btn btn-warning me-2">
            <i class="fas fa-edit me-2"></i>Edit
        </a>
        <form method="POST" action="/products/<%= product._id %>/delete" style="display: inline;">
            <button type="submit" class="btn btn-danger btn-delete">
                <i class="fas fa-trash me-2"></i>Delete
            </button>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-info-circle me-2"></i>
                    Product Information
                </h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-3">
                        <strong>Product Name:</strong>
                    </div>
                    <div class="col-sm-9">
                        <%= product.name %>
                    </div>
                </div>
                
                <div class="row mb-3">
                    <div class="col-sm-3">
                        <strong>Address:</strong>
                    </div>
                    <div class="col-sm-9">
                        <%= product.address || 'Not provided' %>
                    </div>
                </div>
                
                <div class="row mb-3">
                    <div class="col-sm-3">
                        <strong>Phone:</strong>
                    </div>
                    <div class="col-sm-9">
                        <%= product.phone || 'Not provided' %>
                    </div>
                </div>
                
                <div class="row mb-3">
                    <div class="col-sm-3">
                        <strong>Supplier:</strong>
                    </div>
                    <div class="col-sm-9">
                        <% if (product.supplierId) { %>
                            <div class="card bg-light">
                                <div class="card-body py-2">
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <strong>Name:</strong><br>
                                            <a href="/suppliers/<%= product.supplierId._id %>" class="text-decoration-none">
                                                <i class="fas fa-truck me-1"></i>
                                                <%= product.supplierId.name %>
                                            </a>
                                        </div>
                                        <div class="col-sm-4">
                                            <strong>Address:</strong><br>
                                            <small class="text-muted">
                                                <%= product.supplierId.address || 'Not provided' %>
                                            </small>
                                        </div>
                                        <div class="col-sm-4">
                                            <strong>Phone:</strong><br>
                                            <small class="text-muted">
                                                <%= product.supplierId.phone || 'Not provided' %>
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } else { %>
                            <span class="text-muted">No supplier assigned</span>
                        <% } %>
                    </div>
                </div>
                
                <div class="row mb-3">
                    <div class="col-sm-3">
                        <strong>Created:</strong>
                    </div>
                    <div class="col-sm-9">
                        <%= new Date(product.createdAt).toLocaleString() %>
                    </div>
                </div>
                
                <div class="row">
                    <div class="col-sm-3">
                        <strong>Last Updated:</strong>
                    </div>
                    <div class="col-sm-9">
                        <%= new Date(product.updatedAt).toLocaleString() %>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-cogs me-2"></i>
                    Quick Actions
                </h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="/products/<%= product._id %>/edit" class="btn btn-warning">
                        <i class="fas fa-edit me-2"></i>Edit Product
                    </a>
                    <% if (product.supplierId) { %>
                        <a href="/suppliers/<%= product.supplierId._id %>" class="btn btn-info">
                            <i class="fas fa-truck me-2"></i>View Supplier
                        </a>
                    <% } %>
                    <a href="/products/new" class="btn btn-success">
                        <i class="fas fa-plus me-2"></i>Add Another Product
                    </a>
                    <hr>
                    <form method="POST" action="/products/<%= product._id %>/delete">
                        <button type="submit" class="btn btn-danger w-100 btn-delete">
                            <i class="fas fa-trash me-2"></i>Delete Product
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

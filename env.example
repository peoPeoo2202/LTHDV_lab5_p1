# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/supplier-product-crud
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/supplier-product-crud
MONGODB_URI=mongodb://localhost:27017/supplier-product-crud

# Server Configuration
PORT=3000
NODE_ENV=development

# Session Secret (for express-session)
SESSION_SECRET=your-secret-key-change-this-in-production
